<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Stage-0 gateway as a per-user LaunchAgent (gap G3). Generated by install.sh; do not edit the
     installed copy. KeepAlive restarts the gateway if it exits for any reason. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.clintecker.weatherstation.gateway</string>
  <key>ProgramArguments</key>
  <array>
    <string>@REPO@/.venv/bin/python</string>
    <string>-u</string>
    <string>-m</string>
    <string>ws0</string>
    <string>serve</string>
    <string>--directory</string>
    <string>@STATE@</string>
    <string>--serial-number</string>
    <string>@RX_SERIAL@</string>
    <string>--log-file</string>
    <string>@STATE@/serve.out</string>
  </array>
  <key>WorkingDirectory</key>
  <string>@REPO@</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <!-- The gateway writes and rotates serve.out itself (the log-file option): launchd cannot rotate a
       file it holds open. serve.err only catches failures before the log file is open. -->
  <key>StandardOutPath</key>
  <string>@STATE@/serve.err</string>
  <key>StandardErrorPath</key>
  <string>@STATE@/serve.err</string>
</dict>
</plist>
